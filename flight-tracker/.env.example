# Copie este arquivo para ".env" e preencha com seus dados.

# Conta Gmail usada para ENVIAR os alertas (precisa de App Password, não a senha normal)
# Gerar em: https://myaccount.google.com/apppasswords
EMAIL_SENDER=seu_email@gmail.com
EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Quem recebe os alertas
EMAIL_RECIPIENT=franchi.contato@gmail.com

# SMTP (padrão Gmail, normalmente não precisa mudar)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Dashboard Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DEBUG=False
